# Application environment: development | production | test
ENVIRONMENT=development

# Optional local DB for editing code only. The real library is https://neshanak.ca.
# Example: postgresql+psycopg://nook:nook@localhost:5432/nook
DATABASE_URL=postgresql+psycopg://nook:nook@localhost:5432/nook

# Secret used to sign JWT access and refresh tokens.
# Generate a long random value before deploying, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes (short-lived).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=14

# Public origin of the frontend. Used for CORS when the API is not reverse-proxied.
FRONTEND_URL=http://localhost:5173

# Public origin of the backend. Used in generated links and cookie Secure flags.
BACKEND_URL=http://localhost:8000

# Cookie settings. Secure cookies are enabled automatically when ENVIRONMENT=production.
COOKIE_SECURE=false

# On the droplet only, Compose loads the TLS overlay:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Maximum size of an imported Netscape bookmark HTML file, in bytes (5 MiB default).
IMPORT_MAX_BYTES=5242880

# Metadata extraction: HTTP timeout in seconds and max response body size in bytes.
METADATA_TIMEOUT_SECONDS=5
METADATA_MAX_BYTES=1048576
