{
  "id": "https://neshanak.ca/",
  "name": "Neshanak",
  "short_name": "Neshanak",
  "description": "Save, organize, and find your bookmarks.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F1E8",
  "theme_color": "#C45C26",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/save",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
